{
  "$schema": "https://json.schemastore.org/package",
  "name": "@avensia-oss/garn",
  "version": "2.0.0-rc.5",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "engines": {
    "node": ">=24.15.0"
  },
  "repository": "https://github.com/avensia-oss/garn",
  "author": "Anders Ekdahl <anders.ekdahl@avensia.com>",
  "license": "MIT",
  "bin": "dist/garn-bin.mjs",
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit false",
    "build:prod": "yarn clean && yarn build && chmod 755 dist/garn-bin.mjs",
    "watch": "yarn build --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "yarn build && node --test test/*.test.cjs",
    "prepack": "echo Running prepack && yarn run build:prod",
    "prepublishOnly": "echo Running prepublishOnly && yarn run build:prod"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "chalk": "^6.0.0",
    "dotenv": "^18.0.0",
    "glob": "^14.0.0",
    "inquirer": "^14.2.0",
    "is-installed-globally": "^1.0.0",
    "keytar": "^7.9.0",
    "minimist": "^1.2.0",
    "open": "^11.0.0",
    "string-similarity": "^4.0.0",
    "through": "^2.3.0"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.0",
    "@types/node": "^26.6.0",
    "@types/string-similarity": "^4.0.0",
    "@types/through": "~0.0.0",
    "prettier": "^3.9.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "dependenciesMeta": {
    "keytar": {
      "built": true
    }
  },
  "packageManager": "yarn@4.18.1"
}
