{
  "buildOnSave": false,
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "jsx": "react",
    "target": "es2024",
    "module": "node20",
    "esModuleInterop": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["es2024", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": true,
    "checkJs": true
  },
  "include": ["src/**/*.mts"]
}
